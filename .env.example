# =============================================================================
# Cognitif Connexion Foot V2 — Docker / staging env (PLACEHOLDERS ONLY)
# =============================================================================
# Copy to `.env` (never commit real secrets):
#   cp .env.example .env
#
# Test/dev DB: Neon (two separate databases — V1 frontend vs V2 backend).
# Future staging/prod DB: Amazon RDS (same variable names, private SG).
# Never point BACKEND migrations at the V1 database.
# =============================================================================

# --- Compose / runtime ---
# On EC2 staging place this file at: /opt/cognitif-connexion/app/.env
# deploy-on-ec2.sh updates ONLY IMAGE_TAG — it never rewrites other secrets.
APP_NAME=Cognitif Connexion Foot 2.0
APP_ENV=staging
DEBUG=false
API_V1_PREFIX=/api/v1
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HTTP_PORT=80
GHCR_OWNER=imrane-ait-dahmade
IMAGE_TAG=master

# --- Frontend (Next.js / Better Auth / Drizzle) — Neon V1 ONLY ---
FRONTEND_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb_v1?sslmode=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
# Public URL seen by browsers (staging: real http://<eip-or-dns> — do not invent a domain)
BETTER_AUTH_URL=http://localhost
# Leave empty for same-origin /api/v1 via nginx; or set public origin if needed
NEXT_PUBLIC_API_URL=
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Backend (FastAPI / SQLAlchemy / Alembic) — Neon V2 ONLY (never V1) ---
# asyncpg form preferred; independent JWT_SECRET (not BETTER_AUTH_SECRET):
BACKEND_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/cognitif_connexion_foot_v2?ssl=require
DB_ECHO=false
JWT_SECRET=generate-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=cognitif-connexion-foot-v2
JWT_AUDIENCE=cognitif-connexion-foot-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Optional one-time admin bootstrap (run manually, do not bake into images)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin
