# Application
APP_NAME=Cognitif Connexion Foot 2.0
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL (Neon V2 TEST) — asyncpg for the app
# Use ssl=require (asyncpg). Alembic converts to sslmode=require for psycopg.
# Example (placeholders only — never commit real credentials):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/cognitif_connexion_foot_v2?ssl=require
DATABASE_URL=
DB_ECHO=false

# JWT (min 32 characters — generate a random secret; never commit real values)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=cognitif-connexion-foot-v2
JWT_AUDIENCE=cognitif-connexion-foot-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Ops-only admin bootstrap (optional). Do not commit real passwords.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin

# AI analysis (FastAPI) — keys stay server-side only
# AI_ANALYSIS_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_ANALYSIS_TIMEOUT_SECONDS=60
# AI_ANALYSIS_MAX_RETRIES=1
# AI_INPUT_COST_PER_1M=0.40
# AI_OUTPUT_COST_PER_1M=1.60
